{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "薪酬计算助手",
  "version": "0.3.20",
  "identifier": "com.salaryassistant.desktop.v3",
  "build": {
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "薪酬计算助手",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 650,
        "backgroundColor": "#F7F9FC"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "nsis"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
